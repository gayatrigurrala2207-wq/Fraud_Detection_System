# Optional backend settings. Defaults are shown; no credentials are required yet.
# The API reads these from the process environment.
FRAUDSHIELD_ENV=development
FRAUDSHIELD_DATA_DIR=data
FRAUDSHIELD_CORS_ORIGINS=http://localhost:5173
# Set to true when the site is served over HTTPS so the session cookie is HTTPS-only.
FRAUDSHIELD_COOKIE_SECURE=false
